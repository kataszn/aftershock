# Postgres connection string used by @repo/db (drizzle-kit + runtime client)
DATABASE_URL=postgres://postgres:yourpassword@localhost:9000/aftershock

# SQS — region is required (the SDK has no default); queue URL comes from the SQS console
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/your-account-id/your-queue-name
AWS_REGION=us-east-1

# Local dev only. Omit these when deployed and use an attached IAM role instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=