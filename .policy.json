{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OutboxRelayCanEnqueue",
      "Effect": "Allow",
      "Action": [
        "sqs:SendMessage"
      ],
      "Resource": [
        "arn:aws:sqs:eu-west-2:690039670036:aftershock-queue"
      ]
    },
    {
      "Sid": "JobConsumerAndDLQMonitor",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:ChangeMessageVisibility"
      ],
      "Resource": [
        "arn:aws:sqs:eu-west-2:690039670036:aftershock-queue",
        "arn:aws:sqs:eu-west-2:690039670036:aftershock-dlq"
      ]
    },
    {
      "Sid": "QueueIntrospection",
      "Effect": "Allow",
      "Action": [
        "sqs:GetQueueAttributes"
      ],
      "Resource": [
        "arn:aws:sqs:eu-west-2:690039670036:aftershock-queue",
        "arn:aws:sqs:eu-west-2:690039670036:aftershock-dlq"
      ]
    }
  ]
}
