{
  "name": "@repo/worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts | aftershock-pretty",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "start": "tsx src/index.ts",
    "tc": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1142.0",
    "@repo/db": "workspace:*",
    "@repo/shared": "workspace:*",
    "@repo/telemetry": "workspace:*",
    "dotenv": "^18.0.4"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}