{
  "family": "aftershock-worker",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/aftershock-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/aftershock-worker-task-role",
  "containerDefinitions": [
    {
      "name": "worker",
      "image": "<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/aftershock-worker:latest",
      "essential": true,
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "AWS_REGION", "value": "<REGION>" },
        {
          "name": "SQS_QUEUE_URL",
          "value": "https://sqs.<REGION>.amazonaws.com/<ACCOUNT_ID>/aftershock-queue"
        },
        {
          "name": "DLQ_URL",
          "value": "https://sqs.<REGION>.amazonaws.com/<ACCOUNT_ID>/aftershock-dlq"
        }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:aftershock/DATABASE_URL"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/aftershock-worker",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "worker",
          "awslogs-create-group": "true"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "node -e \"process.exit(0)\""],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 10
      },
      "portMappings": []
    }
  ]
}