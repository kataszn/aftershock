{
  "logs": {
    "metrics_collected": {
      "prometheus": {
        "prometheus_config": {
          "global": {
            "scrape_interval": "1m",
            "scrape_timeout": "10s"
          },
          "scrape_configs": [
            {
              "job_name": "aftershock-worker",
              "static_configs": [
                {
                  "targets": ["localhost:9464"]
                }
              ]
            }
          ]
        }
      }
    },
    "force_flush_interval": 5
  }
}
